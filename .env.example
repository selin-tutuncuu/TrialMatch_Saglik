# The current prescreening flow is local/rule-based and needs no API key.
TRIALMATCH_ENABLE_EMBEDDINGS=false
TRIALMATCH_EMBEDDING_MODEL=intfloat/multilingual-e5-small
TRIALMATCH_CACHE_DIR=data/cache
TRIALMATCH_REPORT_DIR=reports
TRIALMATCH_LOG_PATH=data/cache/audit.jsonl
TRIALMATCH_TRACE_PATH=data/cache/traces.jsonl
TRIALMATCH_RERANKER=
# Optional Phoenix OTLP/HTTP trace endpoint; install requirements-tracing.txt first.
# Never point traces at an unapproved service.
PHOENIX_COLLECTOR_ENDPOINT=
